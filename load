#!/usr/bin/env bash
# load - download a game from GitHub and start it right away.
#   load tetris     ->  downloads and starts tetris
# Later, start it again with:  run tetris
set -eu

GH_USER="tianksongo-sketch"
REPO="tetrispy"
GAMES_DIR="$HOME/games"

name="${1:-}"
if [ -z "$name" ]; then
  echo "usage: load <game>      example: load tetris"
  exit 1
fi
case "$name" in
  *[!a-zA-Z0-9_-]*) echo "invalid game name: $name"; exit 1 ;;
esac

PY="$(command -v python3 || command -v python || true)"
if [ -z "$PY" ]; then echo "Python 3 is required."; exit 1; fi
if ! command -v curl >/dev/null 2>&1; then echo "curl is required."; exit 1; fi

url="https://raw.githubusercontent.com/$GH_USER/$REPO/main/$name/$name.py"
game="$GAMES_DIR/$name/$name.py"
mkdir -p "$GAMES_DIR/$name"
echo "Downloading $name ..."
if ! curl -fsSL "$url" -o "$game"; then
  echo "Download failed: $url"
  exit 1
fi

echo "Starting $name ... (next time, type: run $name)"
exec "$PY" "$game" "${@:2}"
