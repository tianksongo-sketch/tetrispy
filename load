#!/usr/bin/env bash
# load - download a game from your GitHub "games" repo, then type: run
#   load tetris     ->  Done. Type: run
set -eu

GH_USER="tianksongo-sketch"     # change this once
REPO="tetrispy"                       # repo with one folder per game
GAMES_DIR="$HOME/games"
BIN_DIR="$HOME/.local/bin"

name="${1:-}"
if [ -z "$name" ]; then
  echo "usage: load <game>      example: load tetris"
  exit 1
fi
case "$name" in
  *[!a-zA-Z0-9_-]*) echo "invalid game name: $name"; exit 1 ;;
esac

PY="$(command -v python3 || command -v python || true)"
if [ -z "$PY" ]; then echo "Python 3 is required."; exit 1; fi
if ! command -v curl >/dev/null 2>&1; then echo "curl is required."; exit 1; fi

url="https://raw.githubusercontent.com/$GH_USER/$REPO/main/$name/$name.py"
mkdir -p "$GAMES_DIR/$name" "$BIN_DIR"
echo "Downloading $name ..."
if ! curl -fsSL "$url" -o "$GAMES_DIR/$name/$name.py"; then
  echo "Download failed: $url"
  exit 1
fi

# 'run' starts the most recently loaded game
cat > "$BIN_DIR/run" <<EOF
#!/usr/bin/env bash
exec "$PY" "$GAMES_DIR/$name/$name.py" "\$@"
EOF
chmod +x "$BIN_DIR/run"

echo "Done. Type: run"
case ":$PATH:" in
  *":$BIN_DIR:"*) ;;
  *) echo "One-time setup: add this line to your shell profile:"
     echo "  export PATH=\"$BIN_DIR:\$PATH\"" ;;
esac
